# Copy to .env and fill in your key: cp .env.example .env

# --- Required ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# --- Models ---
# gpt-4o-mini answers questions. Cheap, fast, and accurate enough when the
# context is already retrieved for it.
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.2

# --- Chunking ---
# 1000 chars with 200 overlap. See the README for how these were chosen.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Vector store ---
LANCE_DB_PATH=./data/vector_db
LANCE_DB_TABLE=documents

# --- Figures in PDFs ---
# Describes embedded images with a vision model at ingest time so charts and
# diagrams become searchable. Set to False to make ingestion much cheaper.
ENABLE_MULTIMODAL=True
VISION_MODEL=gpt-4o
IMAGES_PATH=./data/images
MIN_IMAGE_SIZE=100

# --- Quality ---
# Retrieval score below which an answer is flagged as weakly grounded.
MIN_GROUNDING_SCORE=0.25
MAX_UPLOAD_MB=25

# --- Cache and observability ---
CACHE_MAX_ENTRIES=1000
CACHE_TTL_SECONDS=3600
MAX_TRACES=500

# --- API ---
# Comma-separated. Never widen this to "*" in a deployed environment.
CORS_ORIGINS=http://localhost:8501

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
