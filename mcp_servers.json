{
  "servers": {
    "filesystem": {
      "enabled": true,
      "description": "Accede a archivos locales del sistema",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./data"],
      "env": {}
    },
    "fetch": {
      "enabled": true,
      "description": "Obtiene contenido de URLs y páginas web",
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "env": {}
    }
  }
}
